{
  "name": "slidev-theme-storybook",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "keywords": [
    "slidev-theme",
    "slidev",
    "storybook"
  ],
  "engines": {
    "node": ">=18",
    "slidev": ">=0.50.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Nunito Sans",
        "weights": "400,600,700,800,900"
      }
    }
  },
  "files": [
    "assets",
    "components",
    "layouts",
    "styles",
    "global-bottom.vue"
  ],
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@slidev/cli": "^52.19.1",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "storybook": "^10.6.0",
    "vite": "^8.3.0",
    "vue": "^3.5.33"
  }
}